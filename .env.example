DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# False para uso local em http://127.0.0.1.
# True somente quando houver HTTPS corretamente configurado.
DJANGO_SECURE_MODE=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_CSRF_TRUSTED_ORIGINS=

FINANCEIRO_HOST=127.0.0.1
FINANCEIRO_PORT=8000

# Mantém o servidor inacessível pela rede por padrão.
FINANCEIRO_ALLOW_NETWORK=False
FINANCEIRO_LAN_MODE=False

# Gere automaticamente pelo Gerenciador do Windows.
FINANCEIRO_CREDENTIAL_KEY=

# Proteção contra brute force / credential stuffing.
LOGIN_THROTTLE_USERNAME_MAX=5
LOGIN_THROTTLE_IP_MAX=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_LOCK_SECONDS=900

# Sessão expira após 30 minutos de inatividade.
DJANGO_SESSION_AGE_SECONDS=1800

# HSTS: mantenha conservador até confirmar o HTTPS.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# Recuperação de senha por e-mail (SMTP)
PASSWORD_RECOVERY_EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT_SECONDS=15
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_TIMEOUT_SECONDS=3600

